---
import { Image } from "astro:assets";

import Tag from "../Tag.astro";
import type { Item } from "./Item";

interface Props {
  items: Item[];
}

const { items } = Astro.props as Props;
---

<ul class="list mt-10">
  {
    items.map((item) => (
      <a href={item.link}>
        <li class="list-row md:pr-40 hover:bg-base-200">
          <div>
            <Image src={item.image} alt={item.title} width={200} class="rounded" />
          </div>
          <div class="flex flex-col max-lg:list-col-wrap">
            <div class="text-base">{item.title}</div>
            <div class="opacity-60 flex-1 text-sm">{item.text}</div>
            <div class="flex gap-1 mt-2 flex-wrap">
              {item.tags.map((tag) => (
                <Tag tagName={tag} />
              ))}
            </div>
          </div>
        </li>
      </a>
    ))
  }
</ul>
