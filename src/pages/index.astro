---
import Base from "../layouts/Base.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import remcoImage from "../assets/remco.png";
import { Image } from "astro:assets";
---

<Base
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  mainClass="min-h-screen flex-col lg:flex-row flex items-center justify-center max-w-11/12 lg:max-w-5/6 mx-auto gap-10 lg:gap-40"
>
  <div class="prose">
    <h1 class="font-bold text-center lg:text-left">Hi!, I'm Remco Kersten 👋</h1>
    <p>
      Welcome to my digital garden! With my interest in IT, especially networking, security and DevOps, I like to keep discovering new things. I find
      a lot of information on the internet from documentation and blogs by other engineers. To give something back to this great community, I also
      write blogs about something that interests me and want to share.
    </p>
    <div class="flex justify-center lg:justify-start">
      <div class="aura aura-rainbow"><a href="/posts" class="btn">Explore My Blogs<i class="ri-arrow-right-line"></i></a></div>
    </div>
  </div>
  <Image src={remcoImage} alt="Remco Kersten" class="max-w-2xs rounded-2xl shadow-2xl" />
</Base>
